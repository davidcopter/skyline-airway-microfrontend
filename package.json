{
  "name": "skyline-airway-microfrontend",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:remotes": "pnpm --filter !@skyline/shell --parallel dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r --parallel preview",
    "start": "pnpm build && pnpm preview",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3"
  }
}
